<view class="gallery-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <view class="gallery-nav {{selectedTheme ? 'gallery-nav--detail' : ''}}">
    <view class="gallery-nav-back" bindtap="onNavBack">
      <view class="gallery-nav-arrow"></view>
    </view>
    <text class="gallery-nav-title">{{selectedTheme ? currentTheme.name : '图集'}}</text>
    <view class="gallery-nav-right"></view>
  </view>

  <view class="gallery-body {{selectedTheme ? '' : 'gallery-body--themes'}}">
    <view wx:if="{{!selectedTheme}}" class="theme-grid">
      <view
        wx:for="{{themes}}"
        wx:key="id"
        wx:for-item="theme"
        class="theme-card {{theme.unlocked ? '' : 'theme-card--locked'}}"
        bindtap="selectTheme"
        data-id="{{theme.id}}"
      >
        <view class="theme-card-img-wrap">
          <image class="theme-card-img" src="{{theme.cardImage}}" mode="aspectFill" />
          <view class="theme-progress-badge">{{theme.completed}}/{{theme.totalLevels}}</view>
          <view class="theme-card-overlay">
            <text class="theme-name">{{theme.name}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="theme-detail">
      <view class="level-grid">
        <view
          wx:for="{{currentTheme.levels}}"
          wx:key="key"
          wx:for-item="level"
          class="level-card {{level.done ? '' : 'level-card--placeholder'}}"
          bindtap="openLevelPreview"
          data-key="{{level.key}}"
          data-image="{{level.image}}"
          data-done="{{level.done}}"
        >
          <view
            class="level-thumb-box {{pulseKey === level.key ? 'level-thumb-box--pulse' : ''}}"
            style="height: {{thumbHeight}}rpx;"
          >
            <image
              wx:if="{{level.done}}"
              class="level-thumb"
              src="{{level.image}}"
              mode="aspectFill"
            />
            <view wx:else class="level-thumb-placeholder">
              <image class="level-thumb-placeholder-img" src="{{levelPlaceholder}}" mode="aspectFill" />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{showFullscreen}}"
    class="level-fullscreen"
    catchtap="closeFullscreen"
  >
    <image
      class="level-fullscreen-img"
      src="{{fullscreenImage}}"
      mode="aspectFit"
      catchtap="closeFullscreen"
    />
    <view class="level-fullscreen-close" catchtap="closeFullscreen">×</view>
  </view>
</view>