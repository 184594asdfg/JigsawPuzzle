<view class="gallery-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <view class="gallery-nav">
    <view class="gallery-nav-back" bindtap="goBack">
      <view class="gallery-nav-arrow"></view>
    </view>
    <text class="gallery-nav-title">图集</text>
    <view class="gallery-nav-right"></view>
  </view>

  <view class="difficulty-bar">
    <text class="difficulty-label">难度</text>
    <view class="difficulty-chips">
      <view
        wx:for="{{gridOptions}}"
        wx:key="*this"
        class="difficulty-chip {{gridSize === item ? 'difficulty-chip--active' : ''}}"
        bindtap="selectGrid"
        data-grid="{{item}}"
      >{{item}}×{{item}}</view>
    </view>
  </view>

  <view class="gallery-body">
    <block wx:for="{{sections}}" wx:key="id" wx:for-item="section">
      <view class="gallery-section">
        <view class="gallery-section-head">
          <text class="gallery-section-title">{{section.name}}</text>
          <text class="gallery-section-progress">{{section.completed}}/{{section.totalLevels}}</text>
        </view>

        <view class="level-grid">
          <view
            wx:for="{{section.levels}}"
            wx:key="key"
            wx:for-item="level"
            class="level-card {{selectedKey === level.key ? 'level-card--selected' : ''}}"
            bindtap="selectLevel"
            data-key="{{level.key}}"
            data-name="{{level.name}}"
            data-image="{{level.image}}"
            data-theme="{{level.themeId}}"
            data-level="{{level.level}}"
          >
            <view class="level-thumb-box" style="height: {{thumbHeight}}rpx;">
              <image class="level-thumb" src="{{level.image}}" mode="aspectFill" />
              <text wx:if="{{level.done}}" class="level-done-tag">完成</text>
              <view wx:if="{{selectedKey === level.key}}" class="level-check">✓</view>
            </view>
            <text class="level-name">{{level.name}}</text>
            <text class="level-meta">{{gridSize}}×{{gridSize}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="gallery-footer">
    <view class="gallery-footer-info">
      <text wx:if="{{hasSelection}}" class="gallery-footer-name">{{selectedName}}</text>
      <text wx:else class="gallery-footer-hint">请选择关卡</text>
      <text class="gallery-footer-grid">难度 {{gridSize}}×{{gridSize}}</text>
    </view>
    <view
      class="gallery-start-btn {{hasSelection ? '' : 'gallery-start-btn--disabled'}}"
      bindtap="startSelected"
    >开始拼图</view>
  </view>
</view>
