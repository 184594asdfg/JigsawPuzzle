.gallery-page {
  width: 100%;
  min-height: 100vh;
  background: #2e76ce;
  box-sizing: border-box;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.status-bar {
  width: 100%;
}

.gallery-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: #2e76ce;
}

.gallery-nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-nav-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg);
}

.gallery-nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.gallery-nav--detail .gallery-nav-title {
  font-size: 32rpx;
  font-weight: 400;
}

.gallery-nav-right {
  width: 64rpx;
}

.gallery-body {
  padding: 20rpx 32rpx;
  box-sizing: border-box;
}

/* 主题列表：横向 flex 换行，一行三个，占满屏宽 */
.gallery-body--themes {
  width: 100%;
  max-width: 100%;
  padding: 16rpx 0 24rpx;
  box-sizing: border-box;
}

.theme-grid {
  width: 100%;
  max-width: 100%;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  margin: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.theme-card {
  width: 33.3333%;
  flex: 0 0 33.3333%;
  box-sizing: border-box;
  padding: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.theme-card:active {
  opacity: 0.92;
}

.theme-card--locked:active {
  opacity: 1;
}

.theme-card-img-wrap {
  position: relative;
  width: 100%;
  height: 0;
  /* 素材 240×337 */
  padding-bottom: 140.42%;
  border-radius: 16rpx;
  overflow: hidden;
  background: transparent;
}

.theme-card-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.theme-card--locked .theme-card-img-wrap {
  opacity: 0.92;
}

.theme-progress-badge {
  position: absolute;
  left: 25rpx;
  top: 27rpx;
  padding: 6rpx 14rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #ffffff;
  text-shadow:
    0.5rpx 0 0 #000000,
    -0.5rpx 0 0 #000000,
    0 0.5rpx 0 #000000,
    0 -0.5rpx 0 #000000,
    0.5rpx 0.5rpx 0 #000000,
    -0.5rpx -0.5rpx 0 #000000,
    0.5rpx -0.5rpx 0 #000000,
    -0.5rpx 0.5rpx 0 #000000;
}

.theme-card-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 15rpx 16rpx;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.theme-name {
  font-size: 29rpx;
  font-weight: 400;
  color: #002f82;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.theme-progress {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
}

.theme-card--locked .theme-progress {
  color: rgba(255, 255, 255, 0.5);
}

.theme-detail {
  padding-top: 8rpx;
}

.level-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.level-card {
  width: 33.333%;
  box-sizing: border-box;
  padding: 8rpx;
}

.level-thumb-box {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  background: transparent;
  box-sizing: border-box;
  transform-origin: center center;
}

.level-thumb-box--pulse {
  animation: level-tap-pulse 0.4s ease-out;
}

@keyframes level-tap-pulse {
  0% {
    transform: scale(1);
  }

  40% {
    transform: scale(1.12);
  }

  100% {
    transform: scale(1);
  }
}

.level-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.level-thumb-placeholder {
  width: 100%;
  height: 100%;
  display: block;
  background: transparent;
}

.level-thumb-placeholder-img {
  width: 100%;
  height: 100%;
  display: block;
}

.level-fullscreen {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000000;
}

.level-fullscreen-img {
  width: 100%;
  height: 100%;
  background: transparent;
}

.level-fullscreen-close {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 16rpx);
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 48rpx;
  color: #ffffff;
  z-index: 201;
}
