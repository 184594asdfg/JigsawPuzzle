/* 莫兰迪青绿 · 图库共用 */
.lib-page {
  min-height: 100vh;
  background: #e8f2ef;
  box-sizing: border-box;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.status-bar {
  width: 100%;
}

.lib-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: #e8f2ef;
}

.lib-nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -8rpx;
}

.lib-nav-back-icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #4a6b62;
  border-bottom: 4rpx solid #4a6b62;
  transform: rotate(45deg);
}

.lib-nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #3d5a52;
}

.gallery-nav-right {
  width: 64rpx;
}

.lib-nav-placeholder {
  width: 64rpx;
}

.lib-body {
  padding: 8rpx 20rpx 24rpx;
}

.lib-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(232, 242, 239, 0) 0%, #e8f2ef 28%);
  box-sizing: border-box;
}

.lib-btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: #6da896;
  box-shadow: 0 8rpx 24rpx rgba(77, 138, 118, 0.28);
}

.lib-btn-primary::after {
  border: none;
}

.lib-btn-primary:active {
  opacity: 0.92;
  transform: scale(0.99);
}
