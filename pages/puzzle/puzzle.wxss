.puzzle-page {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(160deg, #5b6fd8 0%, #6d5b9e 45%, #764ba2 100%);
  box-sizing: border-box;
}

.puzzle-load-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 300;
  display: flex;
  flex-direction: column;
  background: linear-gradient(160deg, #5b6fd8 0%, #6d5b9e 45%, #764ba2 100%);
}

.puzzle-brand {
  flex-shrink: 0;
  padding: 24rpx 0 0;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.puzzle-load-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.puzzle-load-tip {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.status-bar {
  width: 100%;
}

.puzzle-nav {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 16rpx 0 8rpx;
  box-sizing: border-box;
}

.puzzle-nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.puzzle-nav-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid rgba(255, 255, 255, 0.95);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.95);
  transform: rotate(45deg);
}

.puzzle-nav-center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.puzzle-nav-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.2;
}

.puzzle-nav-right {
  width: 72rpx;
  flex-shrink: 0;
}

.puzzle-container {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 30rpx;
  box-sizing: border-box;
}

.puzzle-board {
  position: relative;
  margin: 0 auto;
  flex-shrink: 0;
  box-sizing: border-box;
  touch-action: none;
  isolation: isolate;
}

/* 滤色（Screen）：暗部透明，亮部叠在拼图上 */
.merge-fx-blend,
.merge-fx-image {
  position: absolute;
  z-index: 200;
  pointer-events: none;
  mix-blend-mode: screen;
}

.merge-fx-blend {
  overflow: hidden;
}

.merge-fx-video {
  width: 100%;
  height: 100%;
  mix-blend-mode: screen;
}

.merge-fx-image--show {
  opacity: 1;
}

.merge-fx-image {
  opacity: 0;
  transform: scale(0.88);
  transition: opacity 0.25s ease, transform 0.35s ease-out;
}

.merge-fx-image--show {
  transform: scale(1);
}

.puzzle-group {
  position: absolute;
  transform-origin: 0 0;
  transition: transform 0.22s ease;
  pointer-events: none;
}

.puzzle-group.compound {
  z-index: 2;
  /* 组容器仅作定位，不铺矩形图，形状由真实碎片拼出 */
}

.puzzle-group.no-transition {
  transition: none;
}

.puzzle-piece {
  position: absolute;
  overflow: hidden;
  box-sizing: border-box;
  background: #ffffff;
  padding: 1px;
  border: 1px solid #000000;
  border-radius: 4px;
  transform-origin: 0 0;
  transition: transform 0.22s ease;
  pointer-events: auto;
}

.puzzle-piece.no-transition {
  transition: none;
}

/* 组合块由内联按边控制 padding，避免与默认 1px 叠出内缝 */
.puzzle-piece.in-compound {
  padding: 0;
}

.piece-image-wrap {
  position: absolute;
  left: 1px;
  top: 1px;
  right: 1px;
  bottom: 1px;
  width: auto;
  height: auto;
  overflow: hidden;
  line-height: 0;
  font-size: 0;
  border-radius: 2px;
}

.puzzle-image {
  display: block;
  pointer-events: none;
  vertical-align: top;
}

.puzzle-group.dragging .puzzle-piece {
  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.35));
}

.slice-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  opacity: 0;
  pointer-events: none;
}

.action-buttons {
  width: 100%;
  margin-top: 40rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.reset-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.success-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin: 40rpx;
}

.success-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.success-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.success-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.success-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
