.puzzle-container {
  width: 100%;
  padding: 30rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}

.puzzle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #fff;
  font-size: 28rpx;
}

.back-icon {
  font-size: 36rpx;
}

.back-text {
  font-weight: 500;
}

.game-info {
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
}

.moves-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.shuffle-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shuffle-icon {
  font-size: 36rpx;
}

.puzzle-board {
  position: relative;
  box-sizing: border-box;
  touch-action: none;
}

.puzzle-group {
  position: absolute;
  transform-origin: 0 0;
  transition: transform 0.22s ease;
  pointer-events: none;
}

.puzzle-group.compound {
  z-index: 2;
  /* 组容器仅作定位，不铺矩形图，形状由真实碎片拼出 */
}

.puzzle-group.no-transition {
  transition: none;
}

.puzzle-piece {
  position: absolute;
  overflow: hidden;
  box-sizing: border-box;
  background: #ffffff;
  padding: 1px;
  border: 1px solid #000000;
  border-radius: 4px;
  transform-origin: 0 0;
  transition: transform 0.22s ease;
  pointer-events: auto;
}

.puzzle-piece.no-transition {
  transition: none;
}

/* 融合组：每块独立裁切，仅真实碎片占位，不补齐外接矩形空角 */
.puzzle-piece.in-compound {
  padding: 0;
  border: none;
  background: transparent;
}

.puzzle-piece.in-compound .piece-image-wrap.compound-cell {
  position: absolute;
  left: 0;
  top: 0;
  right: auto;
  bottom: auto;
  width: 100%;
  height: 100%;
  border-radius: 0;
}

.piece-image-wrap {
  position: absolute;
  left: 1px;
  top: 1px;
  right: 1px;
  bottom: 1px;
  width: auto;
  height: auto;
  overflow: hidden;
  line-height: 0;
  font-size: 0;
  border-radius: 2px;
}

.puzzle-image {
  display: block;
  pointer-events: none;
  vertical-align: top;
}

.puzzle-group.dragging .puzzle-piece {
  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.35));
}

.slice-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  opacity: 0;
  pointer-events: none;
}

.action-buttons {
  margin-top: 40rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.reset-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.success-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  background: #fff;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin: 40rpx;
}

.success-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.success-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.success-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.success-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
