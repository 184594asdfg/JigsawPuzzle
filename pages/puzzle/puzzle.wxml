<view class="puzzle-container">
  <view class="puzzle-header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
      <text class="back-text">返回</text>
    </view>
    <view class="game-info">
      <text class="moves-text">步数: {{moves}}</text>
    </view>
    <view class="shuffle-btn" bindtap="shufflePuzzle">
      <text class="shuffle-icon">🔄</text>
    </view>
  </view>

  <view
    class="puzzle-board"
    style="width: {{boardW}}px; height: {{boardH}}px;"
    catchtouchmove="noop"
  >
    <view
      wx:for="{{groups}}"
      wx:for-item="group"
      wx:key="id"
      class="puzzle-group {{group.dragging ? 'dragging' : ''}} {{group.noTransition ? 'no-transition' : ''}} {{group.isCompound ? 'compound' : ''}}"
      style="left: {{group.x}}px; top: {{group.y}}px; width: {{group.w}}px; height: {{group.h}}px; transform: translate({{group.tx}}px, {{group.ty}}px); z-index: {{group.dragging ? 100 : (group.isCompound ? 2 : 1)}};"
      data-gid="{{group.id}}"
    >
      <view
        wx:for="{{group.pieces}}"
        wx:for-item="piece"
        wx:key="id"
        class="puzzle-piece {{piece.noTransition ? 'no-transition' : ''}} {{piece.inCompound ? 'in-compound' : ''}}"
        style="left: {{piece.localX}}px; top: {{piece.localY}}px; width: {{cellW}}px; height: {{cellH}}px; border-radius: {{piece.borderRadius}}; {{piece.paddingStyle}} {{piece.borderStyle}} transform: translate({{piece.tx}}px, {{piece.ty}}px);"
        data-pid="{{piece.id}}"
        catchtouchstart="handleTouchStart"
        catchtouchmove="handleTouchMove"
        catchtouchend="handleTouchEnd"
        catchtouchcancel="handleTouchEnd"
      >
        <view class="piece-image-wrap" style="{{piece.wrapStyle}}">
          <image
            class="puzzle-image"
            src="{{imageUrl}}"
            mode="scaleToFill"
            style="width: {{imgW}}px; height: {{imgH}}px; transform: translate({{piece.offsetX}}px, {{piece.offsetY}}px);"
          />
        </view>
      </view>
    </view>

    <view
      wx:if="{{showMergeFx && !mergeFxUseImage && mergeVideoSrc}}"
      class="merge-fx-blend"
      style="left: {{mergeVideoX}}px; top: {{mergeVideoY}}px; width: {{mergeVideoW}}px; height: {{mergeVideoH}}px;"
    >
      <video
        id="mergeFxVideo"
        class="merge-fx-video"
        src="{{mergeVideoSrc}}"
        autoplay
        obey-mute-switch="{{false}}"
        loop="{{false}}"
        controls="{{false}}"
        show-center-play-btn="{{false}}"
        show-fullscreen-btn="{{false}}"
        enable-progress-gesture="{{false}}"
        object-fit="contain"
        bindended="onMergeVideoEnd"
        binderror="onMergeVideoError"
        bindloadedmetadata="onMergeVideoReady"
      />
    </view>
    <image
      wx:if="{{showMergeFx && mergeFxUseImage}}"
      class="merge-fx-image merge-fx-image--show"
      src="{{mergeFxImage}}"
      mode="aspectFit"
      style="left: {{mergeVideoX}}px; top: {{mergeVideoY}}px; width: {{mergeVideoW}}px; height: {{mergeVideoH}}px;"
    />
  </view>

  <view class="action-buttons">
    <button class="action-btn reset-btn" bindtap="resetPuzzle">重新开始</button>
  </view>
</view>

<view wx:if="{{showSuccess}}" class="success-modal">
  <view class="modal-content">
    <text class="success-icon">🎉</text>
    <text class="success-title">挑战成功！</text>
    <text class="success-desc">恭喜你完成了拼图,共使用 {{moves}} 步</text>
    <button class="success-btn" bindtap="handleSuccessClose">再玩一次</button>
  </view>
</view>
