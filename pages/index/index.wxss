.home-page {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
}

.home-bg {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.home-bg-mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.05) 0%,
    rgba(0, 0, 0, 0) 45%,
    rgba(0, 0, 0, 0.35) 100%
  );
}

/* 中部主视觉，靠下贴近底部图标 */
.home-hero-wrap {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: calc(80rpx + env(safe-area-inset-top));
  bottom: calc(0rpx + env(safe-area-inset-bottom));
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 12rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.home-hero {
  width: 100%;
  height: 100%;
  max-width: 700rpx;
  display: block;
}

.home-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  z-index: 2;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  column-gap: 12rpx;
  align-items: center;
  padding: 28rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
}

.bottom-slot {
  display: flex;
  align-items: center;
  min-width: 0;
}

.bottom-slot--left {
  justify-content: flex-start;
}

.bottom-slot--center {
  justify-content: center;
}

.bottom-slot--right {
  justify-content: flex-end;
}

.home-icon-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-icon-btn::after {
  border: none;
}

.home-icon-btn:active {
  opacity: 0.88;
  transform: scale(0.96);
}

.home-icon {
  display: block;
}

.home-icon--side {
  width: 108rpx;
  height: 108rpx;
}

.home-icon--main {
  width: 168rpx;
  height: 168rpx;
}

.home-icon-btn--main {
  flex-shrink: 0;
}

/* 排行榜弹框 */
.rank-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(30, 30, 50, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.rank-modal {
  width: 100%;
  max-height: 100%;
  background: #e8f2ef;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.25);
}

.rank-modal-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  position: relative;
}

.rank-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #3d5a52;
}

.rank-modal-close {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 44rpx;
  color: #7a9a90;
}

.rank-tabs {
  flex-shrink: 0;
  display: flex;
  margin: 0 28rpx 16rpx;
  padding: 6rpx;
  background: #d8ebe5;
  border-radius: 36rpx;
}

.rank-tab {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6d8f84;
  border-radius: 30rpx;
}

.rank-tab--active {
  background: #ffffff;
  color: #3d5a52;
  font-weight: 600;
}

.rank-modal-scroll {
  flex: 1;
  height: 520rpx;
  min-height: 0;
}

.rank-podium {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 8rpx 16rpx 20rpx;
  gap: 10rpx;
}

.podium-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 180rpx;
}

.podium-medal {
  font-size: 36rpx;
}

.podium-item--first .podium-medal {
  font-size: 44rpx;
}

.podium-name {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #3d5a52;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.podium-score {
  font-size: 20rpx;
  color: #7a9a90;
}

.podium-bar {
  width: 100%;
  margin-top: 10rpx;
  border-radius: 12rpx 12rpx 0 0;
  background: #6da896;
}

.podium-bar--1 {
  height: 88rpx;
}

.podium-bar--2 {
  height: 64rpx;
  opacity: 0.8;
}

.podium-bar--3 {
  height: 48rpx;
  opacity: 0.6;
}

.rank-list {
  margin: 0 20rpx 16rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #eef5f2;
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-num {
  width: 44rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #8aa89c;
  text-align: center;
}

.rank-avatar {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: #d8ebe5;
  font-size: 22rpx;
  font-weight: 600;
  color: #5c8a7a;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #3d5a52;
}

.rank-meta {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #8aa89c;
}

.rank-mine {
  flex-shrink: 0;
  margin: 0 20rpx 20rpx;
  padding: 20rpx 24rpx;
  background: #6da896;
  border-radius: 20rpx;
}

.rank-mine-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
}

.rank-mine-num {
  display: block;
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.rank-mine-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}
